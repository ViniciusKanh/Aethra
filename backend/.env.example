# Seguranca da API. Em producao, defina ENVIRONMENT=production e uma chave
# aleatoria com pelo menos 32 caracteres.
ENVIRONMENT=development
AUTH_ENABLED=false
API_KEY=
CORS_ORIGINS=http://localhost:5500
ENABLE_DOCS=true
FRONTEND_ENABLED=true
FRONTEND_DIR=frontend

# Provider ativo: vllm ou ollama. Para a RTX 4050 local, use Ollama.
PROVIDER=ollama

# Servidor OpenAI-compatible do vLLM
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=EMPTY

# Model ID informado ao vLLM em --served-model-name.
# Tambem pode ser um nome diferente ou um path se o servidor o expuser assim.
DEFAULT_CHAT_MODEL=qwen3.5:9b
DEFAULT_VISION_MODEL=qwen3.5:9b

REQUEST_TIMEOUT=300
APP_NAME=Aethra API
APP_VERSION=1.0.0
APP_DESCRIPTION=API da Aethra para chat, resumo e visao

# Configuracao usada apenas se PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434

# Console administrativo. Use uma chave aleatoria com pelo menos 32 caracteres.
ADMIN_ENABLED=true
ADMIN_API_KEY=SUBSTITUA_POR_UMA_CHAVE_ADMIN_FORTE

# Data Warehouse PostgreSQL. Nunca use a conta proprietaria do banco:
# crie um usuario dedicado com CONNECT, USAGE e SELECT apenas.
DW_ENABLED=false
DW_HOST=10.20.9.21
DW_PORT=5432
DW_DATABASE=seu_banco_dw
DW_USER=aethra_reader
DW_PASSWORD=SUBSTITUA_LOCALMENTE
DW_SSLMODE=prefer
DW_ALLOWED_SCHEMAS=public
DW_TABLE_PREFIXES=fact_,dim_
DW_CONNECT_TIMEOUT=5
DW_STATEMENT_TIMEOUT_MS=30000
DW_MAX_ROWS=200
DW_SCHEMA_CACHE_TTL=300
