# Aplicacao
ENVIRONMENT=development
APP_NAME=Aethra API
APP_VERSION=1.0.0
APP_DESCRIPTION=IA documental privada com fontes verificaveis
ENABLE_DOCS=true
FRONTEND_ENABLED=true
FRONTEND_DIR=frontend
CORS_ORIGINS=http://localhost:5500
REQUEST_TIMEOUT=300

# Chave tecnica opcional para as rotas legadas de API.
AUTH_ENABLED=false
API_KEY=

# Modelo local
PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_CHAT_MODEL=qwen3.5:9b
DEFAULT_VISION_MODEL=qwen3.5:9b
DEFAULT_EMBEDDING_MODEL=qwen3-embedding:0.6b

# Alternativa OpenAI-compatible
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=EMPTY

# Usuarios e sessoes
USER_AUTH_ENABLED=true
REGISTRATION_ENABLED=true
ADMIN_EMAIL=seu.email@empresa.com
SESSION_TTL_HOURS=12
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
COMPANY_NAME=Sua Empresa

# Opcional: cria um admin no startup. Preencha os dois ou deixe os dois vazios.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Segredos podem ser informados na tela segura de primeiro acesso.
# Nunca versione valores reais.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Apenas configuracoes criptografadas ficam neste SQLite local.
LOCAL_CONFIG_DB_PATH=backend/data/aethra_config.db
CONFIG_KEY_PATH=backend/data/.config_key

# Indice documental local. Pasta e credencial do Drive sao salvas pelo painel admin.
KNOWLEDGE_INDEX_PATH=backend/data/knowledge
GOOGLE_DRIVE_MAX_FILE_MB=50
