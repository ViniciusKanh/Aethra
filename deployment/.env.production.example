ENVIRONMENT=production
AUTH_ENABLED=false
API_KEY=
CORS_ORIGINS=https://seu-dominio.example
ENABLE_DOCS=false
FRONTEND_ENABLED=true
FRONTEND_DIR=frontend

PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
DEFAULT_CHAT_MODEL=qwen3.5:9b
DEFAULT_VISION_MODEL=qwen3.5:9b
DEFAULT_EMBEDDING_MODEL=qwen3-embedding:0.6b
REQUEST_TIMEOUT=300

USER_AUTH_ENABLED=true
REGISTRATION_ENABLED=true
ADMIN_EMAIL=admin@sua-empresa.com
COMPANY_NAME=Sua Empresa
LOCAL_CONFIG_DB_PATH=/data/aethra_config.db
CONFIG_KEY_PATH=/data/.config_key
KNOWLEDGE_INDEX_PATH=/data/knowledge

# Defina como secrets no ambiente; nunca commite valores reais.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

APP_NAME=Aethra API
APP_VERSION=1.0.0
APP_DESCRIPTION=IA documental privada com fontes verificaveis
