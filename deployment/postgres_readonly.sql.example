-- Execute como administrador do PostgreSQL e adapte banco, usuario e schemas.
-- A senha abaixo e apenas um marcador: nunca commite a senha real.

CREATE ROLE aethra_reader
  LOGIN
  PASSWORD 'SUBSTITUA_POR_UMA_SENHA_FORTE'
  NOSUPERUSER
  NOCREATEDB
  NOCREATEROLE
  NOINHERIT;

GRANT CONNECT ON DATABASE seu_banco_dw TO aethra_reader;

-- Repita os GRANTs para cada schema dimensional autorizado.
GRANT USAGE ON SCHEMA analytics TO aethra_reader;
GRANT SELECT ON ALL TABLES IN SCHEMA analytics TO aethra_reader;

-- Mantem SELECT para futuras tabelas criadas pelo owner que executar este comando.
ALTER DEFAULT PRIVILEGES IN SCHEMA analytics
  GRANT SELECT ON TABLES TO aethra_reader;

-- Defesa adicional: as sessoes desse usuario iniciam em modo somente leitura.
ALTER ROLE aethra_reader SET default_transaction_read_only = on;
ALTER ROLE aethra_reader SET statement_timeout = '30s';
